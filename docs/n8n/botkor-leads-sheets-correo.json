    {
      "id": "6821d9c5-145c-459a-8719-201ff3cec378",
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Verifica que el lead viene de tu web (firma HMAC) y prepara los datos para Sheets y el correo.\nconst crypto = require('crypto');\n\n// ▼ Pega aquí EXACTAMENTE el mismo valor de N8N_WEBHOOK_SECRET que pusiste en Vercel / .env.local\nconst SECRET = 'PEGA_AQUI_EL_VALOR_DE_N8N_WEBHOOK_SECRET';\nconst MAX_AGE_S = 300; // se rechazan envíos con más de 5 minutos (evita reenvíos copiados)\n\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst ts = String(headers['x-botkor-timestamp'] || '');\nconst sig = String(headers['x-botkor-signature'] || '');\n\n// Cuerpo exacto que firmó la web: viene en binario con la opción \"Raw Body\" del Webhook.\nlet raw = null;\ntry {\n  if (item.binary && item.binary.data) raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch (e) {}\nif (raw === null) raw = JSON.stringify(item.json.body);\n\nlet body = item.json.body;\nif (!body || typeof body !== 'object' || !body.lead) {\n  try { body = JSON.parse(raw); } catch (e) { body = null; }\n}\n\nconst expected = 'sha256=' + crypto.createHmac('sha256', SECRET).update(ts + '.' + raw).digest('hex');\nconst validSig = expected.length === sig.length && crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(sig));\nconst age = Math.abs(Date.now() / 1000 - Number(ts));\nconst fresh = ts !== '' && Number.isFinite(age) && age <= MAX_AGE_S;\n\nlet reason = '';\nif (SECRET.startsWith('PEGA_AQUI')) reason = 'Falta configurar SECRET en el nodo \"Verificar firma\"';\nelse if (!validSig) reason = 'Firma inválida';\nelse if (!fresh) reason = 'Timestamp vencido';\nelse if (!body || body.event !== 'lead.created' || !body.lead) reason = 'Payload no reconocido';\n\nif (reason) return [{ json: { valid: false, reason } }];\n\nconst SECTORS = {\n  salud: 'Salud y Bienestar', comercio: 'Comercio y Retail', industria: 'Industria, Logística e Inmobiliaria',\n  'educacion-tech': 'Educación, Tecnología y Startups', servicios: 'Servicios profesionales', otro: 'Otro sector',\n};\nconst WEB_TYPES = { corporativa: 'Corporativa', ecommerce: 'Tienda Online', landing: 'Landing Page', 'a-medida': 'A medida' };\n\nconst l = body.lead;\nconst utm = (body.source && body.source.utm) || {};\nconst fecha = new Date(body.submittedAt || Date.now()).toLocaleString('es-CO', {\n  timeZone: 'America/Bogota', dateStyle: 'short', timeStyle: 'short',\n});\n\nconst row = {\n  'Fecha': fecha,\n  'ID': body.leadId || '',\n  'Nombre': l.fullName || '',\n  'Empresa': l.company || '',\n  'Sector': SECTORS[l.sector] || l.sector || '',\n  'Tipo de web': WEB_TYPES[l.webType] || l.webType || '',\n  'Canal': l.preferredChannel === 'whatsapp' ? 'WhatsApp' : 'Email',\n  'Email': l.email || '',\n  'WhatsApp': l.whatsapp || '',\n  'Página': (body.source && body.source.page) || '',\n  'Referrer': (body.source && body.source.referrer) || '',\n  'utm_source': utm.utm_source || '',\n  'utm_medium': utm.utm_medium || '',\n  'utm_campaign': utm.utm_campaign || '',\n  'gclid': utm.gclid || '',\n  'fbclid': utm.fbclid || '',\n  'Estado': 'Nuevo',\n};\n\n// Datos para el correo (escapados para HTML).\nconst esc = (v) => String(v).replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst contactLink = l.whatsapp\n  ? '<a href=\"https://wa.me/' + esc(l.whatsapp.replace(/\\D/g, '')) + '\">Escribirle por WhatsApp (' + esc(l.whatsapp) + ')</a>'\n  : '<a href=\"mailto:' + esc(l.email) + '\">Responder a ' + esc(l.email) + '</a>';\nconst rows = [\n  ['Nombre', row['Nombre']], ['Empresa', row['Empresa']], ['Sector', row['Sector']],\n  ['Tipo de web', row['Tipo de web']], ['Canal preferido', row['Canal']], ['Email', row['Email']],\n  ['WhatsApp', row['WhatsApp']], ['Fecha', row['Fecha']], ['Campaña', row['utm_campaign'] || row['utm_source']],\n].filter((r) => r[1]);\nconst html =\n  '<div style=\"font-family:Arial,sans-serif;font-size:15px;color:#0B1020\">' +\n  '<h2 style=\"margin:0 0 12px;color:#2563EB\">Nueva solicitud de cotización</h2>' +\n  '<table cellpadding=\"6\" style=\"border-collapse:collapse\">' +\n  rows.map((r) => '<tr><td style=\"color:#6b7280\">' + esc(r[0]) + '</td><td><strong>' + esc(r[1]) + '</strong></td></tr>').join('') +\n  '</table><p style=\"margin-top:16px\">' + contactLink + '</p>' +\n  '<p style=\"color:#6b7280;font-size:12px\">ID: ' + esc(row['ID']) + '</p></div>';\n\nreturn [{\n  json: {\n    valid: true,\n    row,\n    email: {\n      subject: 'Nuevo lead: ' + row['Empresa'] + ' — ' + row['Tipo de web'],\n      html,\n    },\n  },\n}];"
      }
    },
